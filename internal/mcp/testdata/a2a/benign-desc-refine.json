{
  "name": "Vendor Search Agent",
  "description": "Searches the vendor's documentation and returns the most relevant passages, ranked by relevance.",
  "url": "https://agent.vendor.example/a2a",
  "version": "1.0.0",
  "provider": {"name": "Vendor Inc", "url": "https://vendor.example"},
  "skills": [
    {"id": "search", "name": "Search", "description": "Searches the documentation corpus."}
  ],
  "supportedInterfaces": [
    {"url": "https://agent.vendor.example/a2a", "protocolBinding": "jsonrpc"}
  ],
  "capabilities": {"streaming": true},
  "securitySchemes": {"apiKey": {"type": "apiKey", "in": "header", "name": "X-API-Key"}},
  "defaultInputModes": ["text/plain"],
  "defaultOutputModes": ["text/plain"]
}
